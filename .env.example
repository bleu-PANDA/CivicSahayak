# ==============================================================================
# CivicOS / CivicSahayak Environment Configuration
# ==============================================================================

# Server Ports
PORT=8080
RULES_ENGINE_PORT=8081
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://civicos_user:civicos_pass@localhost:5432/civicos_dev
POSTGRES_USER=civicos_user
POSTGRES_PASSWORD=civicos_pass
POSTGRES_DB=civicos_dev

# Search Engine (OpenSearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=government_schemes

# Deterministic Rules Engine (Amazon Corretto 21)
CORRETTO_URL=http://localhost:8081

# AWS Local Emulation (LocalStack / MinIO)
S3_ENDPOINT=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_DOCUMENTS=civicos-citizen-documents

# MinIO Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# Cedar Policy Engine
CEDAR_POLICY_PATH=./infra/cedar
CEDAR_STRICT_MODE=true

# Strands Multi-Agent Pipeline
STRANDS_MODEL=local-heuristic-and-bedrock
BEDROCK_EMULATION=true
LOG_LEVEL=info
