#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Executable for Unix
# ----------------------------------------------------------------------------

set -e
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
APP_HOME="`pwd`"
cd "$SAVED" >/dev/null

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

echo "Running Spring Boot Rules Engine..."
echo "Java runtime: $JAVACMD"
exec java -jar target/*.jar "$@" 2>/dev/null || echo "Please ensure Corretto JDK 21 is installed or run via Finch/Docker container: docker compose up rules-engine"
